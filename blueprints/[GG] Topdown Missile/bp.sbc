  <ShipBlueprints>
    <ShipBlueprint xsi:type="MyObjectBuilder_ShipBlueprintDefinition">
      <Id Type="MyObjectBuilder_ShipBlueprintDefinition" Subtype="[GG] Topdown Missile" />
      <DisplayName>GroundGame</DisplayName>
      <Description>Topdown 0.3: camera raycast search, inline battery, exterior START 10s and ABORT buttons. Remote page 1: 1 CHECK, 2 SCAN, 3 TEST 10s, 4 LAUNCH 10s, 5/9 ABORT, 6 AIM, 7 down, 8 LOCK camera centerline. Camera sweeps reach 750m, require charge and can miss small targets between rays. Live flight acceptance pending.</Description>
